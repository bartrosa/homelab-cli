services:
  minio:
    image: minio/minio:RELEASE.2024-11-07T00-52-20Z
    container_name: homelab-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${USER}
      MINIO_ROOT_PASSWORD: ${PASSWORD}
    ports:
      - "${PORT}:9000"
      - "${CONSOLE_PORT}:9001"
    volumes:
      - ${DATA_DIR}/data:/data
    networks:
      - homelab-net

networks:
  homelab-net:
    external: true
