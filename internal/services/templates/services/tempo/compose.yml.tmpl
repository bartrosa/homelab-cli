services:
  tempo:
    image: grafana/tempo:2.6.1
    container_name: homelab-tempo
    restart: unless-stopped
    command: ["-config.file=/etc/tempo.yaml"]
    ports:
      - "${PORT}:3200"
    volumes:
      - ${DATA_DIR}/data:/var/tempo
    networks:
      - homelab-net

networks:
  homelab-net:
    external: true
