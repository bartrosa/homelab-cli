services:
  redis:
    image: redis:7.4.1-alpine
    container_name: homelab-redis
    restart: unless-stopped
    command: redis-server --requirepass ${PASSWORD}
    ports:
      - "${PORT}:6379"
    volumes:
      - ${DATA_DIR}/data:/data
    networks:
      - homelab-net

networks:
  homelab-net:
    external: true
