services:
  mysql:
    image: mysql:8.4.2
    container_name: homelab-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${PASSWORD}
      MYSQL_USER: ${USER}
      MYSQL_PASSWORD: ${PASSWORD}
      MYSQL_DATABASE: ${DATABASE}
    ports:
      - "${PORT}:3306"
    volumes:
      - ${DATA_DIR}/data:/var/lib/mysql
    networks:
      - homelab-net

networks:
  homelab-net:
    external: true
