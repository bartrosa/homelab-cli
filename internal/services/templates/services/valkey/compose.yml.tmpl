services:
  valkey:
    image: valkey/valkey:8.0.1-alpine
    container_name: homelab-valkey
    restart: unless-stopped
    command: valkey-server --requirepass ${PASSWORD}
    ports:
      - "${PORT}:6379"
    volumes:
      - ${DATA_DIR}/data:/data
    networks:
      - homelab-net

networks:
  homelab-net:
    external: true
